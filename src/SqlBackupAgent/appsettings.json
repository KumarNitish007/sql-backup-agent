{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\MSSQLLocalDB;Integrated Security=true;TrustServerCertificate=true"
  },
  "Agent": {
    "StateDirectory": "state",
    "MaxConcurrentJobs": 2,
    "Staging": {
      "ServerPath": "C:\SqlBackups\staging",
      "DeleteAfterUpload": false
    },
    "Destinations": {
      "local": { "Type": "Folder", "Path": "C:\SqlBackups\archive" }
    },
    "Retention": {
      "KeepDays": 14,
      "KeepLastFull": 2
    },
    "Jobs": [
      {
        "Name": "nightly-full",
        "Type": "Full",
        "Schedule": "0 1 * * *",
        "Databases": [ "*" ],
        "Exclude": [ "*_drill_*" ],
        "Destinations": [ "local" ]
      },
      {
        "Name": "hourly-diff",
        "Type": "Differential",
        "Schedule": "0 7-23 * * *",
        "Databases": [ "*" ],
        "Exclude": [ "*_drill_*" ],
        "Destinations": [ "local" ]
      },
      {
        "Name": "log-every-15-min",
        "Type": "Log",
        "Schedule": "*/15 * * * *",
        "Databases": [ "*" ],
        "Exclude": [ "*_drill_*" ],
        "Destinations": [ "local" ]
      },
      {
        "Name": "weekly-restore-drill",
        "Kind": "RestoreDrill",
        "Schedule": "0 4 * * 0",
        "Databases": [ "*" ]
      }
    ],
    "Notifications": {
      "OnFailure": true,
      "OnSuccess": false
    }
  }
}
